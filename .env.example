# Live Radar: LIVE detection provider. Copy to .env.local and fill in. NEVER commit real keys (.env*.local is git-ignored).
# Without these, creators are saved but nothing is checked and every status stays UNKNOWN (nothing is guessed).

# Provider endpoint. {username} is replaced with the creator's TikTok username (no @).
RADAR_HTTP_URL=
# Dot-path to the boolean "is live" field in the provider's JSON response, e.g. data.isLive
RADAR_HTTP_LIVE_PATH=
# How the provider gets its data. One of: third-party-service | unofficial-protocol | official-api
RADAR_HTTP_SOURCE=
# API key (sent in the header below) and, if needed, extra headers as JSON.
RADAR_HTTP_API_KEY=
RADAR_HTTP_API_KEY_HEADER=x-api-key
#RADAR_HTTP_HEADERS={"accept":"application/json"}
# Optional JSON paths: viewer count, provider's broadcast/session id (used to tell two broadcasts apart)
#RADAR_HTTP_VIEWERS_PATH=
#RADAR_HTTP_SESSION_PATH=
# What YOU concluded after reading the vendor's terms: permitted | prohibited | unverified
#RADAR_HTTP_COMMERCIAL=unverified
# Display name and the minimum gap (ms) between checks of one creator that the vendor's rate limits allow
#RADAR_HTTP_NAME=
#RADAR_HTTP_MIN_INTERVAL_MS=30000

# REQUIRED for any provider that is not an official API. Setting this to "yes" is your statement that you have read
# TikTok's terms and the provider's terms and accept the risk described in docs/LIVE_RADAR_PHASE2_DECISION_REPORT.md.
RADAR_ACKNOWLEDGE_PLATFORM_TERMS=

# Tuning (defaults shown)
#RADAR_POLL_INTERVAL_S=60
#RADAR_OFFLINE_CONFIRMATIONS=2
#RADAR_CONCURRENCY=2
# Set to 1 to stop the background monitor from starting with the server.
#RADAR_DISABLE_MONITOR=
