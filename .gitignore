# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local video storage
/storage/uploads/*
/storage/clips/*
/storage/transcripts/*
/storage/thumbs/*
!/storage/uploads/.gitkeep
!/storage/clips/.gitkeep

# python venv
.venv/



# creator/permission records (local data)
/storage/radar.json
/storage/database.json
/storage/radar-experiments/
!.env.example

# Creative Studio local data (identities, sound library, audio cache, settings)
/storage/studio/
/storage/auto/
